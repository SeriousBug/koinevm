root@koinevm:/# echo one
one
root@koinevm:/# read x
root@koinevm:/# echo "read:$x"
read:hello there
root@koinevm:/# read -u 2 y; echo "e:$y"
e:stderr there
root@koinevm:/# [ -t 0 ] && echo console-0 || echo pipe-0
console-0
root@koinevm:/# [ -t 1 ] && echo console-1 || echo pipe-1
console-1
root@koinevm:/# printf x | { read -r y; [ -t 0 ] || echo not-a-tty; }
not-a-tty
root@koinevm:/# dd iflag=nonblock bs=1 count=1 2>&1 | head -1
dd: error reading 'standard input': Resource temporarily unavailable
root@koinevm:/# printf "%s\n" a b c | wc -l
3
root@koinevm:/# nosuchcommand 2>/dev/null || echo "status:$?"
status:127
root@koinevm:/# sleep 30


root@koinevm:/# echo "status:$?"
status:130
root@koinevm:/# dash -c 'trap "echo caught" INT; sleep 30'
caught

root@koinevm:/# echo "status:$?"
status:130
root@koinevm:/# exit
exit
